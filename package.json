{
  "name": "grimstudio",
  "productName": "GrimStudio",
  "version": "2.5.2",
  "description": "Dual-head 3D makeup editor with verified packaged model assets and redesigned workspace",
  "main": "src/main.cjs",
  "author": "GrimStudio",
  "license": "MIT",
  "scripts": {
    "validate:assets": "node scripts/validate-assets.cjs",
    "build:renderer": "esbuild src/app.js --bundle --platform=browser --format=iife --target=chrome120 --minify --legal-comments=none --outfile=src/app.bundle.js",
    "start": "npm run validate:assets && npm run build:renderer && electron .",
    "dist": "npm run validate:assets && npm run build:renderer && electron-builder --win --x64 && node scripts/verify-packaged-assets.cjs",
    "test": "npm run validate:assets && npm run build:renderer && node tests/smoke-test.cjs && node tests/spatial-raycast-test.cjs && node tests/model-assets-test.cjs",
    "test:static": "npm run validate:assets && node tests/smoke-test.cjs && node tests/spatial-raycast-test.cjs && node tests/model-assets-test.cjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "qrcode": "^1.5.4",
    "three": "0.187.0"
  },
  "build": {
    "appId": "com.grimstudio.desktop",
    "productName": "GrimStudio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/models/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GrimStudio",
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "language": "1033"
    },
    "portable": {
      "artifactName": "GrimStudio-${version}-portable.${ext}"
    },
    "artifactName": "GrimStudio-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "assets/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@45.4.1": true
  }
}
